---
import type { Locale } from "../lib/lang";
import { useI18n } from "../i18n";
import { routeUrl, tel } from "../lib/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { t } = useI18n(locale);
---

<nav class="bottom-bar" aria-label={t("nav.quick")}>
  <a href={`tel:${tel}`}>
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2Z"></path></svg>
    <span>{t("nav.call")}</span>
  </a>
  <a href={`sms:${tel}`}>
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v11H9l-5 4Z"></path></svg>
    <span>{t("nav.text")}</span>
  </a>
  <a class="is-primary" href={routeUrl(locale, "book")}>
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16v14H4ZM4 10h16M8 3v5M16 3v5M8 14h3"></path></svg>
    <span>{t("nav.book")}</span>
  </a>
</nav>
