---
// SVG line drawings in currentColor, made for this demo. Each stands in for a photo slot
// (src/assets/photos/README.md) until Ming's own photos exist. Decorative: the text around them carries the meaning.
interface Props {
  name: "lift" | "brake" | "map" | "hatch" | "sedan" | "coupe" | "wrench" | "tire" | "fleet" | "screen";
  class?: string;
}
const { name, class: cls } = Astro.props;
const big = name === "lift" || name === "brake" || name === "map";
const box = { lift: "0 0 320 180", brake: "0 0 320 240", map: "0 0 320 200" }[name as "lift"] ?? "0 0 64 40";
---

<svg class:list={["art", `art-${name}`, cls]} viewBox={box} fill="none" stroke="currentColor" stroke-width={big ? 1.5 : 1.75} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {
    name === "lift" && (
      <>
        <path d="M96 12h128M110 12v6M210 12v6M0 172h320" />
        <path d="M18 36v136M302 36v136M10 36h16M294 36h16M18 128h94M302 128h-92M100 128v-14M220 128v-14" />
        <path d="M34 108v-12q0-8 10-10l40-6 32-22q6-4 16-4h68q10 0 18 6l30 20 38 6q10 2 10 12v10" />
        <path d="M122 62l-14 18h56V62ZM172 62v18h64l-22-18Z" />
        <circle cx="92" cy="108" r="16" /><circle cx="92" cy="108" r="6" />
        <circle cx="236" cy="108" r="16" /><circle cx="236" cy="108" r="6" />
        <path d="M108 108h112M34 108h42M252 108h34" />
        <path d="M60 172v-8M260 172v-8M150 172v-4M170 172v-4" stroke-dasharray="2 4" />
      </>
    )
  }
  {
    name === "brake" && (
      <>
        <circle cx="140" cy="124" r="92" /><circle cx="140" cy="124" r="80" stroke-dasharray="3 5" />
        <circle cx="140" cy="124" r="38" /><circle cx="140" cy="124" r="12" />
        {[0, 72, 144, 216, 288].map((a) => (
          <circle cx={140 + 24 * Math.cos((a * Math.PI) / 180)} cy={124 + 24 * Math.sin((a * Math.PI) / 180)} r="4" />
        ))}
        <path d="M206 50q44 30 44 74t-44 74l-16-14q32-24 32-60t-32-60Z" />
        <path d="M222 70l18-8M226 178l18 8M214 92v64" />
        <circle cx="216" cy="74" r="13" class="callout" /><text x="216" y="79" text-anchor="middle" class="callout-n">1</text>
        <circle cx="48" cy="60" r="13" class="callout" /><text x="48" y="65" text-anchor="middle" class="callout-n">2</text>
        <circle cx="266" cy="196" r="13" class="callout" /><text x="266" y="201" text-anchor="middle" class="callout-n">3</text>
        <path d="M60 68l18 14M254 186l-12-8" stroke-dasharray="2 3" />
      </>
    )
  }
  {
    name === "map" && (
      <>
        <path d="M0 52h320M0 140h320M84 0v200M232 0v200" stroke-width="10" class="road" />
        <path d="M0 52h320M0 140h320M84 0v200M232 0v200" stroke-dasharray="6 8" />
        <path d="M100 68h116v56H100ZM248 68h60v56h-60ZM12 68h56v56H12ZM100 156h116v36H100ZM12 8h56v28H12ZM100 8h116v28H100Z" />
        <path d="M150 124v-18h26v18" />
        <path d="M120 112l-6-14q0-10 10-10t10 10l-6 14-4 6Z" stroke-width="2" />
        <circle cx="124" cy="98" r="3" />
        <path d="M262 82h20v28h-20Z" /><text x="272" y="101" text-anchor="middle" class="map-p">P</text>
      </>
    )
  }
  {name === "hatch" && <path d="M6 30v-8l6-2 8-10h22l10 10 6 2v8M12 30h-6M24 30h16M56 30h2M18 30a6 6 0 1 0 12 0a6 6 0 1 0-12 0M40 30a6 6 0 1 0 12 0a6 6 0 1 0-12 0M22 18h28" />}
  {name === "sedan" && <path d="M4 30v-7l8-3 10-8h18l10 8 10 3v7M10 30H4M22 30h18M52 30h8M10 30a6 6 0 1 0 12 0a6 6 0 1 0-12 0M40 30a6 6 0 1 0 12 0a6 6 0 1 0-12 0M14 20h40" />}
  {name === "coupe" && <path d="M4 30v-6l12-4 12-8h12l16 8 4 4v6M10 30H4M22 30h18M52 30h8M10 30a6 6 0 1 0 12 0a6 6 0 1 0-12 0M40 30a6 6 0 1 0 12 0a6 6 0 1 0-12 0M18 20h36" />}
  {name === "wrench" && <path d="M20 34l18-18a8 8 0 0 0 10-10l-5 5-4-1-1-4 5-5a8 8 0 0 0-10 10L15 29a3 3 0 0 0 5 5ZM46 34l-8-8" />}
  {name === "tire" && <path d="M32 4a16 16 0 1 0 0 32a16 16 0 1 0 0-32M32 12a8 8 0 1 0 0 16a8 8 0 1 0 0-16M32 4v6M32 30v6M16 20h6M42 20h6M21 9l4 4M39 27l4 4M43 9l-4 4M25 27l-4 4" />}
  {name === "fleet" && <path d="M2 34v-5l6-2 6-6h14l6 6 4 2v5M8 34a4 4 0 1 0 8 0M28 34a4 4 0 1 0 8 0M22 16v-3l6-2 6-6h14l6 6 6 2v5M48 22a4 4 0 1 0 8 0" />}
  {name === "screen" && <path d="M10 6h44a4 4 0 0 1 4 4v18a4 4 0 0 1-4 4H10a4 4 0 0 1-4-4V10a4 4 0 0 1 4-4ZM24 36h16M32 32v4M16 13h10v12H16ZM32 13h16M32 19h16M32 25h10" />}
</svg>
