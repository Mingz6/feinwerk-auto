---
import "../styles/global.css";
import { LOCALES, detectLocale, type Locale } from "../lib/lang";
import { clientStrings, hreflang, htmlLang, ogLocale, useI18n } from "../i18n";
import { assetUrl, pathPrefix, routeUrl, site, siteBase, type Route } from "../lib/site";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BottomBar from "../components/BottomBar.astro";
import { Font, fontData } from "astro:assets";

interface Props {
  locale: Locale;
  route: Route;
  title: string;
  description: string;
  /** The 404 is served for any URL, so it must not redirect or advertise alternates. */
  notFound?: boolean;
}

const { locale, route, title, description, notFound = false } = Astro.props;
const { t } = useI18n(locale);
// Preload only the latin files of the headline and body faces (the first variant in astro.config.mjs).
// <Font preload> can't filter local variants by subset, and latin-ext would add about 170 KB the English page never uses.
const preloads = (["--font-display", "--font-body"] as const).map((v) => fontData[v][0].src[0].url);
const abs = (path: string) => new URL(path, Astro.site).href;

// Same values as --bg in src/styles/tokens.css.
const THEME_COLOR = { light: "#F9FAFC", dark: "#0C1015" };

// Runs before first paint: sets the stored theme (Auto means no attribute) and the matching theme-color.
const themeScript = `(function(){var d=document.documentElement;d.classList.add("js");try{var t=localStorage.getItem("feinwerk-theme");if(t==="light"||t==="dark"){d.dataset.theme=t;var c=${JSON.stringify(THEME_COLOR)}[t];document.querySelectorAll('meta[name="theme-color"]').forEach(function(m){m.content=c})}}catch(e){}})();`;

// Only English pages carry this. A stored manual choice wins over the browser's languages;
// /fr/, /zh-hans/ and /zh-hk/ never redirect, and without JavaScript the English page stays.
const langScript = `(function(){try{
var detect=${detectLocale.toString()};
var locales=${JSON.stringify(LOCALES)};
var s=localStorage.getItem("feinwerk-lang");
var l=locales.indexOf(s)>=0?s:detect(navigator.languages&&navigator.languages.length?navigator.languages:[navigator.language||"en"]);
var prefix=${JSON.stringify(pathPrefix)}[l];
if(!prefix)return;
var base=${JSON.stringify(siteBase)};
location.replace(base+"/"+prefix+location.pathname.slice(base.length).replace(/^\\//,"")+location.search+location.hash);
}catch(e){}})();`;
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={THEME_COLOR.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={THEME_COLOR.dark} media="(prefers-color-scheme: dark)" />
    <script is:inline set:html={themeScript} />
    {locale === "en" && !notFound && <script is:inline set:html={langScript} />}
    <Font cssVariable="--font-display" />
    <Font cssVariable="--font-body" />
    <Font cssVariable="--font-mono" />
    {preloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={assetUrl("favicon.svg")} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={ogLocale[locale]} />
    {
      !notFound && (
        <>
          <meta property="og:url" content={abs(routeUrl(locale, route))} />
          <link rel="canonical" href={abs(routeUrl(locale, route))} />
          {LOCALES.map((l) => (
            <link rel="alternate" hreflang={hreflang[l]} href={abs(routeUrl(l, route))} />
          ))}
          <link rel="alternate" hreflang="x-default" href={abs(routeUrl("en", route))} />
        </>
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">{t("skip")}</a>
    <aside class="concept" data-concept aria-label={t("strip.label")}>
      <p><strong>{t("strip.label")}</strong> · {t("strip.text")}</p>
    </aside>
    <Header locale={locale} route={notFound ? undefined : route} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <BottomBar locale={locale} />
    <script is:inline id="i18n" type="application/json" set:html={JSON.stringify(clientStrings(locale))} />
    <script>
      import "../scripts/ui";
    </script>
  </body>
</html>
