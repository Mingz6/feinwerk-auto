{
  "ci": {
    "collect": {
      "startServerCommand": "npx astro preview --host 127.0.0.1 --port 4322",
      "startServerReadyPattern": "4322",
      "url": [
        "http://127.0.0.1:4322/feinwerk-auto/",
        "http://127.0.0.1:4322/feinwerk-auto/book/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox",
        "formFactor": "mobile",
        "throttlingMethod": "simulate",
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638.4,
          "cpuSlowdownMultiplier": 4
        }
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "pessimistic"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "pessimistic"
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "pessimistic"
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 1800,
            "aggregationMethod": "pessimistic"
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05,
            "aggregationMethod": "pessimistic"
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 100,
            "aggregationMethod": "pessimistic"
          }
        ],
        "total-byte-weight": [
          "error",
          {
            "maxNumericValue": 500000,
            "aggregationMethod": "pessimistic"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
